{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge://schemas/sidecars/design/design-spec-issues.schema.json",
  "title": "Design spec issues sidecar",
  "description": "Shape of .design-spec-issues.json. Residual python still asserts path match vs design-spec-gate and true booleans.",
  "type": "object",
  "required": [
    "spec_path",
    "issues_written",
    "user_confirmed",
    "beads_mode",
    "issues"
  ],
  "properties": {
    "spec_path": {
      "type": "string",
      "minLength": 1
    },
    "issues_written": {
      "type": "boolean"
    },
    "user_confirmed": {
      "type": "boolean"
    },
    "beads_mode": {
      "type": "string",
      "enum": ["active", "degraded", "none"]
    },
    "epic_id": {
      "type": ["string", "null"]
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "summary",
          "spec_sections",
          "acceptance_criteria"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "spec_sections": {
            "type": "array",
            "minItems": 1
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
